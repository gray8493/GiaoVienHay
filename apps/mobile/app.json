{
  "expo": {
    "name": "Scholaro",
    "slug": "scholaro-mobile",
    "version": "1.0.0",
    "entryPoint": "./index.js",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scholaro.app"
    },
    "android": {
      "package": "com.scholaro.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Scholaro dùng camera để quét mã QR mời lớp học."
        }
      ]
    ]
  }
}
