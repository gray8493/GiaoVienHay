# Sao chép file này thành .env và điền giá trị thật.

# URL của backend NestJS (Mặc định đã tự trỏ tới Render Cloud https://giaovienhay.onrender.com/api/v1)
# Chỉ bỏ comment nếu muốn chuyển sang chạy local backend:
EXPO_PUBLIC_API_URL=https://giaovienhay.onrender.com/api/v1
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1


# Firebase Web App credentials — Firebase Console → Project Settings →
# General → Your apps (Web app). Giá trị mặc định của dự án đã hardcode
# đúng trong src/config/firebase.ts; các biến này chỉ để override.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Web Push certificate key (VAPID) — Firebase Console → Cloud Messaging →
# Web Push certificates. Chỉ cần cho push trên trình duyệt web; native bỏ qua.
EXPO_PUBLIC_FCM_VAPID_KEY=
