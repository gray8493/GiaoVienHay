# Sao chép file này thành .env và điền giá trị thật.

# URL của backend NestJS (bắt buộc khi chạy trên thiết bị thật —
# dùng IP LAN của máy chạy backend, ví dụ http://192.168.1.10:3000/api/v1)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Firebase Web App credentials (dùng cho FCM push notification trên web)
# Lấy từ Firebase Console → Project Settings → General → Your apps (Web app).
#projectId và messagingSenderId đã hardcode đúng trong src/config/firebase.ts,
# chỉ cần điền apiKey và appId nếu muốn override.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
