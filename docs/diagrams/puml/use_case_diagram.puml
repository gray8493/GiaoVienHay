@startuml
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam BoxPadding 10
skinparam packageStyle rectangle

skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #1E88E5
    FontSize 11
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #1565C0
    ArrowColor #2E7D32
    FontSize 11
}

skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #FBC02D
    FontSize 10
}

title Sơ Đồ Use Case Toàn Hệ Thống (System Use Case Diagram) - GiaoVienHay (EduConnect)\nQuản Lý Học Sinh Cấp 1 & 2: Phân Quyền GVCN/GVBM, AI Quiz & Random Học Sinh

' ==============================================================================
' 1. ĐỊNH NGHĨA CÁC TÁC NHÂN (ACTORS)
' ==============================================================================

actor "Quản trị viên / BGH\n(Admin)" as Admin
actor "Giáo viên Chủ nhiệm\n(GVCN)" as GVCN
actor "Giáo viên Bộ môn\n(GVBM)" as GVBM
actor "Phụ huynh Học sinh\n(Parent)" as Parent

actor "Google Gemini AI\n(SYS-01)" as GeminiAI <<System>>
actor "Firebase FCM\n(SYS-02)" as FCM <<System>>

' ==============================================================================
' 2. DANH MỤC USE CASE THEO PHÂN HỆ
' ==============================================================================

rectangle "Hệ Thống GiaoVienHay (EduConnect) - Cấp 1 & Cấp 2" {

    package "Phân hệ Quản trị Trường học (Admin Portal)" {
        usecase "UC-ADM-01\nQuản lý Niên khóa & Khối 1-9" as UC_Classes
        usecase "UC-ADM-02\nPhân công GVCN & GV Bộ môn" as UC_Assign
        usecase "UC-ADM-03\nQuản lý Hồ sơ Học sinh & Phụ huynh" as UC_Students
        usecase "UC-ADM-04\nCấu hình Biểu phí & BHYT" as UC_ConfigFee
    }

    package "Phân hệ Giáo viên Chủ nhiệm (GVCN)" {
        usecase "UC-ACA-01\nĐiểm danh Chuyên cần Lớp chủ nhiệm" as UC_Attendance
        usecase "UC-ACA-03\nNhận xét Hạnh kiểm & Rèn luyện" as UC_Remarks
        usecase "UC-FEE-01\nQuản lý Thu Học phí & BHYT\n(is_paid_tuition, is_paid_insurance)" as UC_FeesInsurance
    }

    package "Phân hệ Giáo viên Bộ môn (GVBM)" {
        usecase "UC-ACA-02\nNhập & Phê duyệt Điểm số môn phụ trách" as UC_Grades
        usecase "UC-ACA-04\nImport Docs/PDF bằng AI\nSinh câu hỏi kiểm tra bài cũ" as UC_AIQuiz
        usecase "UC-ACA-05\nVòng quay / Random Học sinh\n(Lọc học sinh có mặt hôm nay)" as UC_RandomStudent
    }

    package "Phân hệ Phụ huynh (Parent Portal)" {
        usecase "UC-PAR-01\nTra cứu Điểm & Học bạ điện tử" as UC_ViewGrades
        usecase "UC-PAR-02\nTheo dõi Chuyên cần & Cảnh báo vắng" as UC_ViewAttendance
        usecase "UC-PAR-03\nTra cứu Tình trạng Học phí & BHYT" as UC_ViewFees
        usecase "UC-PAR-04\nNhận Thông báo Đẩy tức thời (FCM)" as UC_ReceiveNoti
    }
}

' ==============================================================================
' 3. LIÊN KẾT TÁC NHÂN VỚI USE CASE
' ==============================================================================

' Admin
Admin --> UC_Classes
Admin --> UC_Assign
Admin --> UC_Students
Admin --> UC_ConfigFee

' GVCN (Thừa kế quyền Giáo viên và có thêm quyền chủ nhiệm)
GVCN --> UC_Attendance
GVCN --> UC_Remarks
GVCN --> UC_FeesInsurance
GVCN --> UC_AIQuiz
GVCN --> UC_RandomStudent

' GVBM
GVBM --> UC_Grades
GVBM --> UC_AIQuiz
GVBM --> UC_RandomStudent

' Parent
Parent --> UC_ViewGrades
Parent --> UC_ViewAttendance
Parent --> UC_ViewFees
Parent --> UC_ReceiveNoti

' Hệ thống bên ngoài
UC_AIQuiz ..> GeminiAI : <<invokes>>\nBóc tách & sinh câu hỏi
UC_Attendance ..> FCM : <<trigger>>\nCảnh báo vắng học
UC_Grades ..> FCM : <<trigger>>\nThông báo điểm mới
UC_FeesInsurance ..> FCM : <<trigger>>\nNhắc nộp BHYT/Học phí
UC_ReceiveNoti <-- FCM

@enduml
