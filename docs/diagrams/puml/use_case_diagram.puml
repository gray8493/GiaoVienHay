@startuml
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam BoxPadding 10
skinparam packageStyle rectangle

skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #1E88E5
    FontSize 11
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #1565C0
    ArrowColor #2E7D32
    FontSize 11
}

skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #FBC02D
    FontSize 10
}

title Sơ Đồ Use Case Toàn Hệ Thống (System Use Case Diagram) - GiaoVienHay\nQuản Lý Học Sinh Cấp 1 & 2: Dò Bài Cũ, AI Quiz & Tạo Game Tương Tác Lớp Học

' ==============================================================================
' 1. ĐỊNH NGHĨA CÁC TÁC NHÂN (ACTORS)
' ==============================================================================

actor "Quản trị viên Nền tảng\n(Platform Admin)" as Admin
actor "Giáo viên Bộ môn\n(GVBM)" as GVBM
actor "Giáo viên Chủ nhiệm\n(GVCN)" as GVCN
actor "Phụ huynh Học sinh\n(Parent)" as Parent

actor "Google Gemini AI\n(SYS-01)" as GeminiAI <<System>>
actor "Firebase FCM\n(SYS-02)" as FCM <<System>>

' GVCN kế thừa toàn bộ năng lực sư phạm của GVBM
GVBM <|-- GVCN : <<kế thừa quyền giảng dạy>>

note "<b>PHẠM VI HỆ THỐNG:</b>\n- KHÔNG có Tác nhân Học sinh (Student)\n- KHÔNG có tính năng học sinh làm bài kiểm tra trực tuyến\n- Giáo viên tự tạo lớp, mời PH qua link\n- Admin chỉ quản trị: CRUD, Ban, Limit" as ScopeNote
ScopeNote .. GVBM
ScopeNote .. GVCN

' ==============================================================================
' 2. DANH MỤC USE CASE THEO PHÂN HỆ
' ==============================================================================

rectangle "Hệ Thống GiaoVienHay - Cấp 1 & Cấp 2" {

    package "Phân hệ Quản trị Nền tảng (Platform Admin)" {
        usecase "UC-ADM-01\nCRUD Tài khoản & Dữ liệu Hệ thống" as UC_AdminCRUD
        usecase "UC-ADM-02\nKhóa & Mở khóa Tài khoản (Ban/Unban)" as UC_AdminBan
        usecase "UC-ADM-03\nCấu hình Hạn mức Tài nguyên (Limit/Quota)\n(Lớp học, Học sinh, Lượt gọi AI)" as UC_AdminLimit
    }

    package "Phân hệ Nghiệp vụ Sư phạm & Lớp học (GVBM & GVCN)" {
        usecase "UC-ACA-02\nNhập Sổ Điểm Đa Môn Học\n(Nhiều môn & Nhiều loại điểm:\nMiệng, 15p, 1 tiết, Giữa kỳ, Cuối kỳ)" as UC_Grades
        usecase "UC-ACA-04\nDò bài cũ & Quay Random Học sinh\n(Lọc học sinh có mặt hôm nay)" as UC_RandomStudent
        usecase "UC-ACA-05\nImport Docs/PDF bằng AI (Gemini)\nSinh câu hỏi kiểm tra bài cũ" as UC_AIQuiz
        usecase "UC-ACA-06\nTạo & Khởi chạy Mini-game Lớp học\n(Rung chuông vàng, Đua xe, Hộp quà)" as UC_ClassroomGame
        usecase "UC-ACA-07\nNhập Điểm Kiểm Tra Tại Lớp &\nXem Bảng Xếp Hạng (Leaderboard)" as UC_Leaderboard
    }

    package "Phân hệ Quản trị Lớp chủ nhiệm (Dành riêng cho GVCN)" {
        usecase "UC-CLS-01\nTự tạo Lớp học & Thêm Học sinh\n(Sinh Invite Link & QR)" as UC_CreateClass
        usecase "UC-ACA-01\nĐiểm danh Chuyên cần Lớp chủ nhiệm" as UC_Attendance
        usecase "UC-ACA-03\nNhận xét Hạnh kiểm & Rèn luyện định kỳ" as UC_Remarks
        usecase "UC-FEE-01\nQuản lý Thu Học phí & BHYT\n(Cờ boolean: is_paid_tuition, is_paid_insurance)" as UC_FeesInsurance
    }

    package "Phân hệ Phụ huynh (Parent Portal)" {
        usecase "UC-PAR-00\nTham gia Lớp bằng Link mời &\nXác nhận liên kết con em" as UC_JoinByLink
        usecase "UC-PAR-01\nTra cứu Bảng Điểm Đa Môn\n& Học bạ điện tử của con" as UC_ViewGrades
        usecase "UC-PAR-02\nTheo dõi Chuyên cần & Cảnh báo vắng" as UC_ViewAttendance
        usecase "UC-PAR-03\nTra cứu Tình trạng Học phí & BHYT" as UC_ViewFees
        usecase "UC-PAR-04\nNhận Thông báo Đẩy tức thời (FCM)" as UC_ReceiveNoti
    }
}

' ==============================================================================
' 3. LIÊN KẾT TÁC NHÂN VỚI USE CASE
' ==============================================================================

' Admin (Platform)
Admin --> UC_AdminCRUD
Admin --> UC_AdminBan
Admin --> UC_AdminLimit

' GVBM (và GVCN qua kế thừa)
GVBM --> UC_Grades
GVBM --> UC_RandomStudent
GVBM --> UC_AIQuiz
GVBM --> UC_ClassroomGame
GVBM --> UC_Leaderboard

' Quyền đặc thù của GVCN
GVCN --> UC_CreateClass
GVCN --> UC_Attendance
GVCN --> UC_Remarks
GVCN --> UC_FeesInsurance

' Phụ huynh
Parent --> UC_JoinByLink
Parent --> UC_ViewGrades
Parent --> UC_ViewAttendance
Parent --> UC_ViewFees
Parent --> UC_ReceiveNoti

' Hệ thống bên ngoài
UC_AIQuiz ..> GeminiAI : <<invokes>>\nBóc tách nội dung
UC_ClassroomGame ..> GeminiAI : <<invokes>>\nSinh kịch bản Game
UC_Attendance ..> FCM : <<trigger>>\nCảnh báo vắng học
UC_Grades ..> FCM : <<trigger>>\nThông báo điểm mới
UC_FeesInsurance ..> FCM : <<trigger>>\nNhắc nộp BHYT/Học phí
UC_ReceiveNoti <-- FCM

@enduml

