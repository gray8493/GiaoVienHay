@startuml
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam BoxPadding 10

skinparam node {
    BackgroundColor #FFFFFF
    BorderColor #1E88E5
    FontSize 11
    FontStyle bold
}

skinparam artifact {
    BackgroundColor #F8F9FA
    BorderColor #1565C0
    FontSize 10
}

skinparam database {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    FontSize 11
}

skinparam cloud {
    BackgroundColor #FFF3E0
    BorderColor #EF6C00
    FontSize 11
    FontStyle bold
}

title Sơ Đồ Triển Khai Hạ Tầng (Deployment Diagram) - GiaoVienHay\nNền Tảng Đám Mây Tối Ưu: Vercel, Railway/Render & Toàn Diện Google Firebase Cloud

' ==============================================================================
' 1. THIẾT BỊ ĐẦU CUỐI (CLIENT DEVICES)
' ==============================================================================

node "Thiết Bị Lớp Học & Văn Phòng\n(PC / Laptop / Smartboard Bảng Tương Tác)" as Device_Desktop {
    artifact "Trình duyệt Web Hiện đại\n(Google Chrome / MS Edge)" as Browser
}

node "Thiết Bị Di Động\n(Smartphone Android / iOS)" as Device_Mobile {
    artifact "Ứng dụng Di động Native\n(React Native App Bundle)" as MobileApp
}

' ==============================================================================
' 2. NỀN TẢNG CLOUD PAAS (VERCEL & COMPUTE SERVICE)
' ==============================================================================

cloud "Vercel Global Edge Network (PaaS)" as VercelCloud {
    node "Vercel Serverless & Edge Cluster" {
        artifact "Web Quản trị & Trợ giảng\n(Next.js 14 Standalone App)" as NextjsApp
    }
}

cloud "PaaS Compute Platform (Railway / Render)" as PaasCloud {
    node "Compute Service (Docker Container)" as ApiNode {
        artifact "Backend API Server\n(NestJS Modular Monolith Runtime\nNode.js v20 LTS)" as NestjsApp
    }
}

' ==============================================================================
' 3. HỆ SINH THÁI GOOGLE FIREBASE CLOUD PLATFORM (DATABASE & SERVICES DUY NHẤT)
' ==============================================================================

cloud "Google Firebase Cloud Platform (Dịch Vụ Dữ Liệu Duy Nhất)" as FirebaseCloud {
    node "Managed NoSQL Database" {
        database "Google Cloud Firestore\n(Collections: users, classes, students,\nattendances, scores, fees_and_insurance,\nquizzes, questions, quiz_results, notifications)" as FirestoreInstance
    }

    node "Firebase Cloud Storage" {
        artifact "Bucket Lưu trữ Giáo án & Tài liệu\n(.docx, .pdf, ảnh avatar)" as StorageBucket
    }
    
    node "Firebase Cloud Messaging (FCM)" {
        artifact "FCM Push Gateway Service\n(Gửi Multicast Notification)" as FcmGateway
    }

    node "Firebase Authentication" {
        artifact "Identity & Access Management\n(Phone SMS OTP, Email/Password)" as FirebaseAuth
    }
}

cloud "Google Cloud AI" as GoogleAI {
    node "Gemini AI Engine Endpoint" {
        artifact "Gemini 1.5 Flash API" as GeminiEndpoint
    }
}

' ==============================================================================
' CÁC KẾT NỐI MẠNG & GIAO THỨC (NETWORK CONNECTIONS)
' ==============================================================================

' Client tương tác với Web và API
Browser --> NextjsApp : HTTPS / TLS 1.3 (:443)\n(Truy cập Web Quản trị & Bảng tương tác)
Browser --> NestjsApp : HTTPS REST API (:443)\n(Gọi API dữ liệu, bốc thăm, quiz)
MobileApp --> NestjsApp : HTTPS REST API (:443)\n(Gửi điểm danh, tra cứu điểm số, xem BHYT)

' Vercel Next.js giao tiếp với Backend
NextjsApp --> NestjsApp : HTTPS RESTful Calls / Server Actions

' Backend kết nối trực tiếp Firebase Cloud (Firebase Admin SDK)
NestjsApp --> FirestoreInstance : gRPC / HTTPS Firebase Admin SDK\n(Đọc / ghi dữ liệu NoSQL, Realtime)
NestjsApp --> StorageBucket : HTTPS Firebase Admin SDK\n(Upload & đọc tài liệu giáo án)
NestjsApp --> FcmGateway : HTTPS FCM HTTP v1 API\n(Gửi thông báo đẩy vắng học, điểm mới, nhắc BHYT)
NestjsApp --> FirebaseAuth : HTTPS Firebase Admin SDK\n(Verify ID Token, gán Custom Claims RBAC)

' Client đồng bộ trực tiếp với Firebase
FcmGateway -.-> MobileApp : Push Alert Notifications (APNs / FCM Native)
FirestoreInstance -.-> NextjsApp : Realtime Snapshot Listeners (Leaderboard, Sĩ số)
FirestoreInstance -.-> MobileApp : Realtime Updates

' Backend kết nối AI
NestjsApp --> GeminiEndpoint : HTTPS API (@google/genai)\n(Gửi văn bản sinh câu hỏi & Game)

@enduml
