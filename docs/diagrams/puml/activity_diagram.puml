@startuml
skinparam roundCorner 8
skinparam BoxPadding 10
skinparam conditionStyle insidediamond

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #1E88E5
    ArrowColor #2E7D32
    FontSize 11
}

skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #FBC02D
    FontSize 10
}

title Sơ Đồ Hoạt Động Toàn Chu Trình Vận Hành Hệ Thống (End-to-End System Activity Diagram)\nGiaoVienHay - Quản Trị, Nghiệp Vụ Sư Phạm & Cổng Phụ Huynh (100% Nền Tảng Firebase)

' ==============================================================================
' ĐỊNH NGHĨA CÁC PHÂN VÙNG LÀN BƠI (SWIMLANES)
' ==============================================================================

|#E3F2FD|Quản trị viên (Admin)|
|#E1F5FE|Giáo viên (GVCN & GVBM)|
|#EDE7F6|Client App (Next.js / React Native)|
|#FFF3E0|Backend NestJS (API & Services)|
|#E8F5E9|Cơ Sở Dữ Liệu (Cloud Firestore)|
|#FCE4EC|Dịch Vụ Firebase & AI (Storage, FCM, Gemini)|
|#F3E5F5|Phụ huynh (Parent)|

' ==============================================================================
' GIAI ĐOẠN 1: GIÁO VIÊN TỰ TẠO LỚP, THÊM HỌC SINH & PHỤ HUYNH VÀO LỚP BẰNG LINK
' ==============================================================================

|Giáo viên (GVCN & GVBM)|
start
:Đăng nhập ứng dụng (Web hoặc Mobile App);
if (Vai trò của Giáo viên?) then ([Giáo viên Chủ nhiệm (GVCN)])
    :Tạo **Lớp học tổng** (Tên lớp, Khối 1-9, Năm học);
    :Thêm danh sách Học sinh vào lớp (nhập trực tiếp hoặc tải file Excel);
    :Phân công Giáo viên bộ môn (GVBM) phụ trách từng môn học;

    |Client App (Next.js / React Native)|
    :Gửi yêu cầu tạo lớp, danh sách học sinh & phân công GVBM lên Backend;

    |Backend NestJS (API & Services)|
    :Khởi tạo Lớp học tổng & sinh **Mã mời & Link mời vào lớp (Invite Link)**;
    :Lưu thông tin Lớp học và danh sách Học sinh;
    :Khởi tạo các bản ghi theo dõi BHYT (cờ mặc định FALSE);

    |Cơ Sở Dữ Liệu (Cloud Firestore)|
    :Lưu vào /classes (kèm invite_code, invite_link, subject_teachers), /students và /fees_and_insurance;

    |Client App (Next.js / React Native)|
    :Hiển thị Link mời tham gia lớp học kèm mã QR / nút Sao chép;

    |Giáo viên (GVCN & GVBM)|
    :Sao chép Link mời & gửi vào nhóm Phụ huynh (Zalo / Tin nhắn);
else ([Giáo viên Bộ môn (GVBM)])
    :Truy cập vào Lớp học tổng đã được GVCN phân công giảng dạy;
endif

|Phụ huynh (Parent)|
:Nhấp vào **Link mời vào lớp** được Giáo viên chia sẻ;
:Đăng nhập ứng dụng (bằng SĐT nhận OTP hoặc Email);
:Xem danh sách học sinh lớp & chọn/xác nhận học sinh là con mình;

|Backend NestJS (API & Services)|
:Xác thực ID Token & cập nhật liên kết Phụ huynh - Học sinh;

|Cơ Sở Dữ Liệu (Cloud Firestore)|
:Cập nhật parent_uids trong /students và gán classId cho tài khoản Phụ huynh;

|Phụ huynh (Parent)|
:Nhận thông báo "Tham gia lớp học thành công" và sẵn sàng kết nối;

' ==============================================================================
' GIAI ĐOẠN 2: NGHIỆP VỤ SƯ PHẠM, ĐIỂM DANH & QUẢN LÝ BHYT (GIÁO VIÊN)
' ==============================================================================

|Giáo viên (GVCN & GVBM)|
:Mở ứng dụng (Web hoặc Mobile App React Native);
if (Nghiệp vụ thực hiện tại lớp?) then ([Điểm danh chuyên cần đầu giờ])
    |Giáo viên (GVCN & GVBM)|
    :GVCN chọn lớp chủ nhiệm trên Mobile App;
    :Điểm danh nhanh: Chạm đánh dấu học sinh vắng;
    :Bấm "Lưu điểm danh";
    
    |Backend NestJS (API & Services)|
    :Ghi nhận dữ liệu điểm danh ngày hôm nay;
    
    |Cơ Sở Dữ Liệu (Cloud Firestore)|
    :Lưu vào collection /attendances;
    
    |Backend NestJS (API & Services)|
    :Xác định danh sách học sinh vắng để kích hoạt thông báo;

else if ([Quản lý Sổ điểm Đa môn & Đa cột điểm])
    |Giáo viên (GVCN & GVBM)|
    :Mở Sổ điểm điện tử trên Web Next.js hoặc Mobile App;
    :Chọn Lớp học và chọn **Môn học phụ trách**
    (Toán, Tiếng Việt, Tiếng Anh, Khoa học, Lịch sử...);
    :Chọn **Học kỳ** (HK1 / HK2) và chọn **Cột điểm thành phần**:
    - Điểm kiểm tra miệng / dò bài cũ (ORAL_TEST)
    - Điểm kiểm tra 15 phút (TEST_15P)
    - Điểm 1 tiết / kiểm tra định kỳ (TEST_1P)
    - Điểm thi Giữa kỳ (MID_TERM)
    - Điểm thi Cuối kỳ (FINAL);
    :Nhập/cập nhật bảng điểm số theo danh sách học sinh (thang điểm 10);
    
    |Client App (Next.js / React Native)|
    :Gửi dữ liệu bảng điểm môn học lên Backend;
    
    |Backend NestJS (API & Services)|
    :Lưu trữ các đầu điểm thành phần vào collection /scores
    (Hệ thống lưu đúng các cột điểm do giáo viên nhập, không tự động tính GPA môn);
    
    |Cơ Sở Dữ Liệu (Cloud Firestore)|
    :Cập nhật các document trong /scores;
    
    |Client App (Next.js / React Native)|
    :Hiển thị **BẢNG XẾP HẠNG (LEADERBOARD) ĐIỂM MÔN HỌC**:
    - Trình chiếu vinh danh Top học sinh điểm cao nhất môn (Top 1, Top 2, Top 3)
    - Thống kê phổ điểm và danh sách thứ hạng của môn học trong lớp;
    
    |Giáo viên (GVCN & GVBM)|
    :Trình chiếu Bảng xếp hạng điểm môn học lên màn hình lớp & bấm **"Công bố điểm"**;
    
    |Cơ Sở Dữ Liệu (Cloud Firestore)|
    :Cập nhật cờ is_published = TRUE trong /scores;

else if ([Khởi động bài cũ / Mini-game bằng AI])
    |Giáo viên (GVCN & GVBM)|
    :Tải giáo án .docx/.pdf môn học lên Web Next.js;
    
    |Dịch Vụ Firebase & AI (Storage, FCM, Gemini)|
    :Firebase Storage lưu trữ tệp tài liệu an toàn;
    :Google Gemini AI phân tích bóc tách giáo án và sinh bộ câu hỏi trắc nghiệm;
    
    |Cơ Sở Dữ Liệu (Cloud Firestore)|
    :Lưu bộ câu hỏi vào /quizzes và subcollection /questions;
    
    |Giáo viên (GVCN & GVBM)|
    :Tổ chức tương tác bài cũ / Mini-game tại lớp (chiếu lên bảng);
    :Khởi động **Vòng quay Random** quay ngẫu nhiên chọn học sinh;
    if (Học sinh quay trúng nghỉ học hoặc vắng mặt?) then ([Bấm Bỏ qua])
        :Giáo viên bấm nút **"Bỏ qua (Skip)"**;
        :Hệ thống tự động quay tiếp vòng mới chọn bạn khác;
    else ([Có mặt sẵn sàng])
    endif
    :Học sinh lên bảng hoặc giơ bảng trả lời mini-game (không làm bài online);
    :Giáo viên trực tiếp chấm & nhập điểm vào môn học đang dạy;
    
    |Client App (Next.js / React Native)|
    :Gửi dữ liệu điểm vừa nhập lên Backend;
    
    |Backend NestJS (API & Services)|
    :Lưu điểm vào /quiz_results và sổ điểm /scores của môn học;
    
    |Cơ Sở Dữ Liệu (Cloud Firestore)|
    :Cập nhật các document trong /quiz_results và /scores;

else if ([Nhận xét & Đánh giá học sinh])
    |Giáo viên (GVCN & GVBM)|
    :Chọn học sinh cần nhận xét trên Web hoặc Mobile App;
    :Nhập **lời nhận xét ngắn gọn (đoạn text ngắn)**
    (Ví dụ: "Hôm nay em phát biểu rất hăng hái", "Cần chú ý nghe giảng hơn" - Không dùng nhãn tags);
    :Bấm "Gửi nhận xét";
    
    |Client App (Next.js / React Native)|
    :Gửi dữ liệu nhận xét lên Backend;
    
    |Backend NestJS (API & Services)|
    :Lưu trữ nhận xét (đoạn text ngắn) vào collection /remarks;
    :Kích hoạt thông báo tức thì tới Phụ huynh của học sinh đó;
    
    |Cơ Sở Dữ Liệu (Cloud Firestore)|
    :Lưu bản ghi nhận xét vào /remarks;

else ([Quản lý thu nộp BHYT / Học phí])
    |Giáo viên (GVCN & GVBM)|
    :GVCN mở danh sách lớp chủ nhiệm;
    :Tích chọn cờ boolean (is_paid_tuition, is_paid_insurance) khi học sinh nộp;
    :Lọc danh sách các em chưa nộp BHYT và bấm "Nhắc nhở";
    
    |Cơ Sở Dữ Liệu (Cloud Firestore)|
    :Cập nhật cờ nộp trong collection /fees_and_insurance;
endif

' ==============================================================================
' GIAI ĐOẠN 3: BẮN THÔNG BÁO TỨC THÌ QUA FIREBASE CLOUD MESSAGING (FCM)
' ==============================================================================

|Backend NestJS (API & Services)|
:Truy xuất parent_uids và fcm_tokens từ Firestore;
:Gửi yêu cầu Multicast Push tới Firebase Cloud Messaging;

|Dịch Vụ Firebase & AI (Storage, FCM, Gemini)|
:Firebase FCM chuyển phát thông báo đẩy tức thì tới điện thoại Phụ huynh;

|Cơ Sở Dữ Liệu (Cloud Firestore)|
:Lưu nhật ký thông báo vào collection /notifications;

' ==============================================================================
' GIAI ĐOẠN 4: CỔNG PHỤ HUYNH - TRA CỨU HỌC BẠ & TRẠNG THÁI BHYT (PARENT)
' ==============================================================================

|Phụ huynh (Parent)|
:Nhận âm thanh & banner thông báo đẩy trên Mobile App;
:Chạm vào thông báo để mở App React Native;
if (Nội dung thông báo?) then ([Thông báo điểm mới])
    :Mở **Sổ Điểm Điện Tử** của con trên App;
    :Tra cứu Bảng điểm các môn học:
    - Bảng điểm chi tiết: Toán, Tiếng Việt, Tiếng Anh, KHTN...
    - Các đầu điểm thành phần: Miệng, 15 phút, 1 tiết, Giữa kỳ, Cuối kỳ;
else if ([Thông báo nhận xét mới từ giáo viên]) then ([Nhận xét])
    :Mở Sổ liên lạc điện tử của con;
    :Xem chi tiết lời nhận xét (đoạn text ngắn) của giáo viên;
    :Bấm "Xác nhận đã đọc" để phản hồi với giáo viên;
else if ([Thông báo vắng học]) then ([Vắng học])
    :Xem chi tiết ngày vắng & lịch sử chuyên cần của con;
else ([Nhắc nhở nộp BHYT / Học phí])
    :Mở mục "Học phí & BHYT" trên App;
    :Tra cứu tình trạng nghĩa vụ tài chính của con em:
    - Trạng thái Học phí (Đã nộp / Chưa nộp)
    - Trạng thái BHYT (Đã nộp / Chưa nộp kèm hạn chót);
    :Xem hướng dẫn nộp tiền trực tiếp tại trường cho GVCN;
endif
stop

@enduml
