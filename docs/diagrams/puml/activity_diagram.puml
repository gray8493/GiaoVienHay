@startuml
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam BoxPadding 10
skinparam conditionStyle insidediamond

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #1E88E5
    ArrowColor #2E7D32
    FontSize 11
}

skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #FBC02D
    FontSize 10
}

title Sơ Đồ Hoạt Động Toàn Chu Trình Vận Hành Hệ Thống (End-to-End System Activity Diagram)\nGiaoVienHay - Quản Trị, Nghiệp Vụ Sư Phạm & Cổng Phụ Huynh (Theo Dõi Cờ BHYT/Học Phí)

' ==============================================================================
' ĐỊNH NGHĨA CÁC PHÂN VÙNG LÀN BƠI (SWIMLANES)
' ==============================================================================

|#E3F2FD|Quản trị viên (Admin)|
|#E1F5FE|Giáo viên (GVCN & GVBM)|
|#EDE7F6|Client App (Next.js / React Native)|
|#FFF3E0|Backend NestJS (API & Services)|
|#E8F5E9|Dữ Liệu & Hàng Đợi (PostgreSQL & RabbitMQ)|
|#FCE4EC|Dịch Vụ Ngoài (Firebase FCM & AI)|
|#F3E5F5|Phụ huynh (Parent)|

' ==============================================================================
' GIAI ĐOẠN 1: THIẾT LẬP CƠ CẤU & DANH MỤC THU NỘP BHYT/HỌC PHÍ (ADMIN)
' ==============================================================================

|Quản trị viên (Admin)|
start
:Đăng nhập Web Quản trị Next.js;
:Thiết lập Khối lớp 1-9, Phân công GVCN & GV Bộ môn;
:Tạo danh sách Học sinh và thiết lập Liên kết với Phụ huynh;
:Cấu hình danh mục thu Học phí & BHYT theo năm học;

|Client App (Next.js / React Native)|
:Gửi yêu cầu khởi tạo cấu trúc và danh mục;

|Backend NestJS (API & Services)|
:Xác thực quyền Admin (RolesGuard);
:Xử lý nghiệp vụ & Mở DB Transaction;

|Dữ Liệu & Hàng Đợi (PostgreSQL & RabbitMQ)|
:Lưu cơ cấu trường, phân công và bản ghi fees_and_insurance (cờ mặc định FALSE);

' ==============================================================================
' GIAI ĐOẠN 2: NGHIỆP VỤ SƯ PHẠM, ĐIỂM DANH & QUẢN LÝ BHYT (GIÁO VIÊN)
' ==============================================================================

|Giáo viên (GVCN & GVBM)|
:Mở ứng dụng (Web hoặc Mobile App React Native);
if (Lựa chọn thao tác nghiệp vụ?) then ([Điểm danh chuyên cần])
    :Mở tính năng "Điểm danh" tại lớp học;
    :Đánh dấu các học sinh Vắng (Có phép / Không phép);
    :Bấm "Lưu điểm danh";
    
    |Client App (Next.js / React Native)|
    :Gửi POST /api/v1/attendance/submit;
    
    |Backend NestJS (API & Services)|
    :Lưu bản ghi điểm danh vào DB;
    if (Có học sinh vắng?) then (Có)
        |Dữ Liệu & Hàng Đợi (PostgreSQL & RabbitMQ)|
        :Phát sự kiện 'StudentAbsentEvent' vào RabbitMQ;
    else (Không)
    endif

else if (Lựa chọn thao tác nghiệp vụ?) then ([Dò bài cũ & Chơi Game AI])
    |Giáo viên (GVCN & GVBM)|
    :Tải giáo án .docx/.pdf lên Web Next.js;
    
    |Dịch Vụ Ngoài (Firebase FCM & AI)|
    :Google Gemini AI phân tích bóc tách và sinh câu hỏi;
    
    |Giáo viên (GVCN & GVBM)|
    :Chọn 1 trong 4 Mini-game (Rung chuông vàng, Đua xe, Hộp quà);
    :Quay Vòng quay Random học sinh (chỉ học sinh CÓ MẶT hôm nay);
    :Chấm điểm miệng và lưu trực tiếp vào sổ điểm;

else ([Quản lý thu nộp BHYT / Học phí])
    |Giáo viên (GVCN & GVBM)|
    :GVCN mở danh sách lớp chủ nhiệm;
    :Tích chọn cờ boolean (is_paid_tuition, is_paid_insurance) khi học sinh nộp;
    :Lọc danh sách các em chưa nộp BHYT và bấm "Nhắc nhở";
    
    |Dữ Liệu & Hàng Đợi (PostgreSQL & RabbitMQ)|
    :Phát sự kiện 'FeeReminderEvent' vào RabbitMQ;
endif

' ==============================================================================
' GIAI ĐOẠN 3: XỬ LÝ BẤT ĐỒNG BỘ & BẮN THÔNG BÁO TỨC THÌ (FCM)
' ==============================================================================

|Dữ Liệu & Hàng Đợi (PostgreSQL & RabbitMQ)|
:RabbitMQ giao sự kiện cho Notification Worker;

|Backend NestJS (API & Services)|
:Notification Service lấy thông tin Phụ huynh liên quan;
:Truy xuất Device Token từ Redis Cache;
:Gửi yêu cầu Multicast Push tới FCM;

|Dịch Vụ Ngoài (Firebase FCM & AI)|
:Firebase FCM chuyển phát thông báo đẩy tới điện thoại Phụ huynh;

' ==============================================================================
' GIAI ĐOẠN 4: CỔNG PHỤ HUYNH - TRA CỨU HỌC BẠ & TRẠNG THÁI BHYT (PARENT)
' ==============================================================================

|Phụ huynh (Parent)|
:Nhận âm thanh & banner thông báo đẩy trên Mobile App;
:Chạm vào thông báo để mở App React Native;
if (Nội dung thông báo?) then ([Thông báo vắng học / Điểm mới])
    :Xem chi tiết bảng điểm hoặc lịch sử điểm danh của con;
    stop
else ([Nhắc nhở nộp BHYT / Học phí])
    :Mở mục "Học phí & BHYT" trên App;
    :Tra cứu tình trạng nghĩa vụ tài chính của con em:
    - Trạng thái Học phí (Đã nộp / Chưa nộp)
    - Trạng thái BHYT (Đã nộp / Chưa nộp kèm hạn chót);
    :Xem hướng dẫn nộp tiền trực tiếp tại trường cho GVCN;
    stop
endif

@enduml
