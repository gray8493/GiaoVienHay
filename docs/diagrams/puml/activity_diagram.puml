@startuml
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam BoxPadding 10
skinparam conditionStyle insidediamond

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #1E88E5
    ArrowColor #2E7D32
    FontSize 11
}

skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #FBC02D
    FontSize 10
}

title Sơ Đồ Hoạt Động Toàn Chu Trình Vận Hành Hệ Thống (End-to-End System Activity Diagram)\nGiaoVienHay (EduConnect) - Bao Quát Cả 3 Nhóm Tác Nhân & Các Nghiệp Vụ Cốt Lõi

' ==============================================================================
' ĐỊNH NGHĨA CÁC PHÂN VÙNG LÀN BƠI (SWIMLANES)
' ==============================================================================

|#E3F2FD|Quản trị viên (Admin)|
|#E1F5FE|Giáo viên (Teacher)|
|#EDE7F6|Client App (Next.js / React Native)|
|#FFF3E0|Backend NestJS (API & Services)|
|#E8F5E9|Dữ Liệu & Hàng Đợi (PostgreSQL & RabbitMQ)|
|#FCE4EC|Dịch Vụ Ngoài (FCM & Payment Gateway)|
|#F3E5F5|Phụ huynh (Parent)|

' ==============================================================================
' GIAI ĐOẠN 1: THIẾT LẬP CƠ CẤU & HỌC PHÍ (ADMIN PORTAL)
' ==============================================================================

|Quản trị viên (Admin)|
start
:Đăng nhập Web Quản trị Next.js;
:Thiết lập Khối lớp, Phân công giảng dạy cho Giáo viên;
:Tạo danh sách Học sinh và thiết lập Liên kết với Phụ huynh;
:Khởi tạo đợt thu Học phí theo kỳ (UC-ADM-04);

|Client App (Next.js / React Native)|
:Gửi yêu cầu khởi tạo cấu trúc và biểu phí;

|Backend NestJS (API & Services)|
:Xác thực quyền Admin (RolesGuard);
:Xử lý nghiệp vụ & Mở DB Transaction;

|Dữ Liệu & Hàng Đợi (PostgreSQL & RabbitMQ)|
:Lưu trữ cơ cấu trường, phân công và hóa đơn học phí vào PostgreSQL;

' ==============================================================================
' GIAI ĐOẠN 2: NGHIỆP VỤ GIẢNG DẠY & CHUYÊN CẦN (TEACHER)
' ==============================================================================

|Giáo viên (Teacher)|
:Mở ứng dụng (Web hoặc Mobile App React Native);
if (Lựa chọn thao tác nghiệp vụ?) then ([Điểm danh chuyên cần])
    :Mở tính năng "Điểm danh" tại lớp học;
    :Đánh dấu các học sinh Vắng (Có phép / Không phép);
    :Bấm "Lưu điểm danh";
    
    |Client App (Next.js / React Native)|
    :Gửi POST /api/v1/attendance/submit;
    
    |Backend NestJS (API & Services)|
    :Lưu bản ghi điểm danh vào DB;
    if (Có học sinh vắng?) then (Có)
        |Dữ Liệu & Hàng Đợi (PostgreSQL & RabbitMQ)|
        :Phát sự kiện 'StudentAbsentEvent' vào RabbitMQ;
    else (Không)
    endif

else ([Nhập điểm môn học])
    |Giáo viên (Teacher)|
    :Mở Sổ điểm trên Web Next.js;
    :Nhập các cột điểm kiểm tra thành phần;
    :Bấm "Phê duyệt & Công bố điểm";
    
    |Client App (Next.js / React Native)|
    :Gửi POST /api/v1/grades/publish;
    
    |Backend NestJS (API & Services)|
    :Kiểm tra thang điểm (0-10) & tính điểm trung bình;
    
    |Dữ Liệu & Hàng Đợi (PostgreSQL & RabbitMQ)|
    :Cập nhật bảng grades trong PostgreSQL;
    :Phát sự kiện 'GradePublishedEvent' vào RabbitMQ;
endif

' ==============================================================================
' GIAI ĐOẠN 3: XỬ LÝ BẤT ĐỒNG BỘ & BẮN THÔNG BÁO TỨC THÌ
' ==============================================================================

|Dữ Liệu & Hàng Đợi (PostgreSQL & RabbitMQ)|
:RabbitMQ giao sự kiện cho Notification Worker;

|Backend NestJS (API & Services)|
:Notification Service lấy thông tin Phụ huynh liên quan;
:Truy xuất Device Token từ Redis Cache;
:Gửi yêu cầu Multicast Push tới FCM;

|Dịch Vụ Ngoài (FCM & Payment Gateway)|
:Firebase FCM chuyển phát thông báo đẩy tới điện thoại Phụ huynh;

' ==============================================================================
' GIAI ĐOẠN 4: CỔNG PHỤ HUYNH - TRA CỨU & THANH TOÁN HỌC PHÍ (PARENT)
' ==============================================================================

|Phụ huynh (Parent)|
:Nhận âm thanh & banner thông báo đẩy trên Mobile App;
:Chạm vào thông báo để mở App React Native;
if (Nội dung thông báo?) then ([Thông báo vắng học / Điểm mới])
    :Xem chi tiết bảng điểm hoặc lịch sử điểm danh của con;
    stop
else ([Thông báo học phí mới])
    :Mở mục "Học phí" trên App;
    :Kiểm tra chi tiết các khoản thu cần nộp;
    :Bấm "Thanh toán ngay" và chọn Cổng thanh toán (VNPAY / MoMo);
    
    |Client App (Next.js / React Native)|
    :Gửi POST /api/v1/payments/create-url;
    
    |Backend NestJS (API & Services)|
    :Tạo giao dịch chờ & sinh chữ ký số (Checksum);
    
    |Dịch Vụ Ngoài (FCM & Payment Gateway)|
    :Cổng thanh toán hiển thị màn hình thanh toán / Mở App ngân hàng;
    
    |Phụ huynh (Parent)|
    :Xác thực OTP / Sinh trắc học để thanh toán;
    
    |Dịch Vụ Ngoài (FCM & Payment Gateway)|
    :Trừ tiền tài khoản & Gửi Webhook IPN về Backend NestJS;
    
    |Backend NestJS (API & Services)|
    :Xác thực chữ ký số Webhook;
    
    |Dữ Liệu & Hàng Đợi (PostgreSQL & RabbitMQ)|
    :Cập nhật trạng thái hóa đơn sang 'PAID' trong PostgreSQL;
    
    |Phụ huynh (Parent)|
    :Nhận biên lai điện tử xác nhận thanh toán thành công;
    stop
endif

@enduml
