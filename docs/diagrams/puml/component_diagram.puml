@startuml
skinparam componentStyle uml2
skinparam roundCorner 8
skinparam defaultFontSize 11

title Sơ Đồ Thành Phần Hệ Thống (Component Diagram) - GiaoVienHay\nKiến Trúc NestJS Modular Monolith Kết Hợp Nền Tảng Google Firebase Toàn Diện

' ==============================================================================
' 1. TẦNG TRÌNH DIỄN (CLIENTS)
' ==============================================================================

package "Presentation Clients" {
    [Web Client (Next.js 14)\n(Admin Portal, GVCN/GVBM Dashboard,\nVòng Quay Random, Trình Chiếu Game)] as WebClient
    [Mobile App (React Native)\n(Điểm danh nhanh GV, Tra cứu điểm,\nChuyên cần & Cờ nộp BHYT Phụ huynh)] as MobileClient
}

' ==============================================================================
' 2. TẦNG ỨNG DỤNG BACKEND (NESTJS MODULAR MONOLITH)
' ==============================================================================

package "NestJS Modular Application (Backend)" {
    
    interface "RESTful API / JSON" as HttpEntry
    
    component [API Gateway / Global Pipe\n(Validation, Exception Filter, Logging)] as Gateway
    component [RBAC & Firebase Auth Guard\n(Phân quyền: Admin, GVCN, GVBM, Parent)] as AuthGuard
    
    package "Core Business Modules" {
        component [Auth Module\n(Firebase Authentication, User Profile)] as AuthMod
        component [Admin Module\n(School, Classes, Grade Levels, Student Profiles)] as AdminMod
        component [Academic & Attendance Module\n(Grades, Daily Attendance Check, Leaderboard)] as AcadMod
        component [Gamification & Quiz Module\n(Doc Parser, Question Generator, Game Engine)] as GameMod
        component [Fees & Insurance Module\n(Quản lý cờ nộp Học phí & BHYT boolean)] as FeeMod
        component [Notification Module\n(Message Dispatcher, FCM Multicast Push)] as NotiMod
    }
    
    component [Firebase Admin SDK Data Access Layer\n(@google-cloud/firestore, firebase-admin)] as FirebaseSDK
}

' ==============================================================================
' 3. TẦNG DỮ LIỆU & HẠ TẦNG GOOGLE FIREBASE
' ==============================================================================

package "Google Firebase Cloud Platform" {
    database "Google Cloud Firestore (NoSQL Document Store)\n(users, classes, students, scores,\nattendances, fees_and_insurance,\nquizzes, questions, quiz_results, notifications)" as FirestoreDB
    [Firebase Cloud Storage\n(Lưu trữ file giáo án .docx, .pdf)] as FBStorage
    [Firebase Cloud Messaging (FCM)\n(Push Notification Gateway)] as FBMessaging
    [Firebase Authentication\n(SMS OTP, Email/Password)] as FBAuth
}

package "External AI Cloud Services" {
    cloud "Google Gemini API\n(gemini-1.5-flash)" as GeminiAI
}

' ==============================================================================
' CÁC LIÊN KẾT & GIAO TIẾP (CONNECTIONS)
' ==============================================================================

WebClient --> HttpEntry : HTTPS / RESTful
MobileClient --> HttpEntry : HTTPS / RESTful

HttpEntry --> Gateway
Gateway --> AuthGuard
AuthGuard --> AuthMod
AuthGuard --> AdminMod
AuthGuard --> AcadMod
AuthGuard --> GameMod
AuthGuard --> FeeMod
AuthGuard --> NotiMod

' Modules liên kết Firebase Admin SDK
AuthMod --> FirebaseSDK
AdminMod --> FirebaseSDK
AcadMod --> FirebaseSDK
FeeMod --> FirebaseSDK
GameMod --> FirebaseSDK
NotiMod --> FirebaseSDK

' Firebase Admin SDK tương tác Firestore
FirebaseSDK --> FirestoreDB : Read / Write / Snapshot Listeners

' Authentication
AuthMod --> FBAuth : Verify ID Tokens / Manage Claims

' AI & Storage
GameMod --> FBStorage : Upload & đọc file giáo án .docx / .pdf
GameMod --> GeminiAI : Gửi văn bản trích xuất sinh câu hỏi & Game

' Push Notifications
NotiMod --> FBMessaging : Gửi Multicast Push Notification
FBMessaging -.-> MobileClient : Đẩy thông báo tức thì (vắng học, điểm mới, nhắc BHYT)

' Realtime Updates
FirestoreDB -.-> WebClient : Realtime Listeners (Leaderboard, Sĩ số)
FirestoreDB -.-> MobileClient : Realtime Snapshot

@enduml
