  "item": [
    {
      "name": "UT02_Users_TC01: Lấy thông tin hồ sơ cá nhân của người dùng đang đăng nhập",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Verify User Profile Response Structure\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.status_code).to.eql(200);",
              "    pm.expect(jsonData.data).to.be.an('object');",
              "    pm.expect(jsonData.data).to.have.property('uid');",
              "    pm.expect(jsonData.data).to.have.property('phone');",
              "    pm.expect(jsonData.data).to.have.property('role');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "users",
            "me"
          ]
        },
        "description": "Truy xuất thông tin hồ sơ tài khoản cá nhân của người dùng đang đăng nhập (GET /api/v1/users/me)."
      }
