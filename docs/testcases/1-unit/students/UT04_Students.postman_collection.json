  "item": [
    {
      "name": "UT04_Students_TC01: Phụ huynh xem thông tin lý lịch con cái thuộc quyền quản lý thành công",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Verify Student Profile Structure\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.status_code).to.eql(200);",
              "    pm.expect(jsonData.data).to.be.an('object');",
              "    pm.expect(jsonData.data.student_id).to.eql('stu_01');",
              "    pm.expect(jsonData.data).to.have.property('full_name');",
              "    pm.expect(jsonData.data).to.have.property('class_id');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "students",
            "{{studentId}}"
          ]
        },
        "description": "Phụ huynh tra cứu lý lịch, lớp học và thông tin cá nhân của con mình (stu_01) thành công (HTTP 200 OK)."
      }
