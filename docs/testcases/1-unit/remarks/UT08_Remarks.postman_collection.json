  "item": [
    {
      "name": "UT08_Remarks_TC01: Gửi lời nhận xét ngắn gọn và bắn thông báo FCM cho phụ huynh",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created or 200 OK\", function () {",
              "    pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "pm.test(\"Verify Remark Created and FCM Delivered\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.be.an('object');",
              "    pm.expect(jsonData.data).to.have.property('remark_id');",
              "    pm.expect(jsonData.data.student_id).to.eql('stu_01');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id\": \"stu_01\",\n  \"class_id\": \"cls_1a_2026\",\n  \"subject_code\": \"MATH\",\n  \"content\": \"Hôm nay em Nam tiếp thu bài rất nhanh và hăng hái xung phong lên bảng chữa bài tập.\"\n}"
