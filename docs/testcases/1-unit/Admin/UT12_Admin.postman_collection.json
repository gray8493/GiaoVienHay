  "item": [
    {
      "name": "UT12_Admin_TC01: Lấy danh sách người dùng toàn hệ thống có phân trang và bộ lọc",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Verify Envelope and pagination data\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.status_code).to.eql(200);",
              "    pm.expect(jsonData.data).to.be.an('object');",
              "    pm.expect(jsonData.data.items).to.be.an('array');",
              "    pm.expect(jsonData.data.page).to.eql(1);",
              "    pm.expect(jsonData.data.limit).to.eql(20);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/users?page=1&limit=20&role=TEACHER_HOMEROOM&keyword=Nguyễn",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "role",
              "value": "TEACHER_HOMEROOM"
            },
            {
              "key": "keyword",
              "value": "Nguyễn"
            },
            {
              "key": "is_active",
              "value": "true",
              "disabled": true
            }
          ]
        },
        "description": "Kịch bản TC01: Quản trị viên lấy danh sách người dùng toàn hệ thống có phân trang và bộ lọc thành công (200 OK)."
      }
    },
    {
      "name": "UT12_Admin_TC02: Chặn và từ chối truy cập khi người dùng không có vai trò Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 Forbidden\", function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "pm.test(\"Verify Forbidden Error Code\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.status_code).to.eql(403);",
              "    pm.expect(jsonData.error_code).to.eql(\"AUTH_ROLE_FORBIDDEN\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{teacherToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/users?page=1&limit=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": "Kịch bản TC02: Sử dụng token không phải Admin (TEACHER_HOMEROOM) để gọi API Admin, kỳ vọng trả về 403 Forbidden."
      }
